generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User & Auth Models

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role      String   @default("USER") // Was Enum Role
  projects  Project[]
  subscription Subscription?
  encryptedOpenAiKey String?
  encryptedWordpressKey String?
  lastBlogGeneratedAt DateTime?
  connectedSites ConnectedSite[]
  activeConnectedSiteId String?  // Currently selected website
  feedback      Feedback[]
  feedbackUpvotes FeedbackUpvote[]
  scheduledPosts ScheduledPost[]
  keywords      Keyword[]
  backlinkExchangeEnabled Boolean @default(false)
  memberships   OrganizationMember[]
  activeOrganizationId String? // Currently selected organization, same pattern as activeConnectedSiteId
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  members              OrganizationMember[]
  invites              OrganizationInvite[]
  projects             Project[]
  connectedSites       ConnectedSite[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
}

model OrganizationInvite {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email           String
  role            String       @default("MEMBER")
  token           String       @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime     @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String  
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}
 
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}
 
model Authenticator {
  id                   String  @id @default(cuid())
  credentialID         String  @unique
  userId               String  
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([userId, credentialID])
}

// App Models

model Project {
  id        String   @id @default(cuid())
  name      String
  domain    String
  country   String   @default("US") // ISO-2 target market for keyword discovery
  userId    String // Original creator; ownership/access is scoped by organizationId, this is unchanged audit info
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable until the backfill migration runs against existing rows, then made required in a follow-up migration
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  analyses  Analysis[]
  keywords  Keyword[]
  keywordSnapshots KeywordSnapshot[]
  scheduledPosts ScheduledPost[]

  // Fully-autonomous monthly discovery + scheduling (Phase 3)
  autopilotEnabled Boolean @default(false)
  autopilotSeedKeyword String? // topic fed to keyword discovery each month
  autopilotConnectedSiteId String? // manual reference to ConnectedSite.id, no relation (matches User.activeConnectedSiteId) - null means publish to the internal blog

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Analysis {
  id            String   @id @default(cuid())
  projectId     String   
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url           String
  score         Int
  title         String?
  description   String?
  h1            String?
  loadTime      Float?
  status        String   @default("COMPLETED")
  results       String? // Stored as JSON string
  createdAt     DateTime @default(now())
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique // e.g., 'basic', 'pro'
  price         Float
  limits        String?  // Stored as JSON string
  autopilotPostsPerMonth Int @default(0) // 0 = disabled, -1 = unlimited
  subscriptions Subscription[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id            String             @id @default(cuid())
  userId        String             @unique 
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String             
  plan          Plan               @relation(fields: [planId], references: [id])
  status        String             @default("ACTIVE")
  startDate     DateTime           @default(now())
  endDate       DateTime?
  stripeSubscriptionId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model ConnectedSite {
  id        String   @id @default(cuid())
  userId    String // Original creator; ownership/access is scoped by organizationId, this is unchanged audit info
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable until the backfill migration runs against existing rows, then made required in a follow-up migration
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type      String   @default("WORDPRESS") // WORDPRESS today; more site types can be added later
  name      String
  url       String
  credentials String // JSON string, shape depends on `type` (WordPress: {username, encryptedAppPassword})
  scheduledPosts ScheduledPost[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String   
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "FEATURE" or "BUG"
  title       String
  description String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, CLOSED
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userUpvotes FeedbackUpvote[]
}

model FeedbackUpvote {
  id         String   @id @default(cuid())
  feedbackId String   
  userId     String   
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId])
}

model ScheduledPost {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Publish target: a connected external site (connectedSiteId set, type read off ConnectedSite.type),
  // or this app's own internal /blog when connectedSiteId is null.
  connectedSiteId String?
  connectedSite   ConnectedSite? @relation(fields: [connectedSiteId], references: [id], onDelete: Cascade)
  blogPost        BlogPost?

  // Optional links back to the site/keyword this post is for (not required - keyword can still be free text)
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  keywordId       String?
  keywordRef      Keyword? @relation(fields: [keywordId], references: [id], onDelete: SetNull)

  // Content configuration
  keyword         String
  intent          String   @default("informational")
  tone            String
  length          Int      @default(1500)
  language        String   @default("en")

  // Scheduling
  scheduledDate   DateTime
  publishStatus   String   @default("draft") // draft or publish

  // Execution status
  status          String   @default("SCHEDULED") // SCHEDULED, GENERATING, PUBLISHED, FAILED

  // Generated content (populated after generation)
  generatedTitle       String?
  generatedContent     String?
  generatedDescription String?
  publishedPostUrl     String?
  errorMessage         String?

  executedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  metaDescription String?
  metaKeywords    String?   // Stored as JSON array string
  content         String    // HTML
  status          String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt     DateTime?

  scheduledPostId String?        @unique
  scheduledPost   ScheduledPost? @relation(fields: [scheduledPostId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Keyword {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  keyword         String
  opportunity     String   @default("Medium") // High, Medium, Low
  difficulty      Int      @default(50)       // 0-100
  volume          Int      @default(0)        // Relative popularity (0-100) from Google Trends, not absolute search volume
  cpc             Float    @default(0)        // Cost per click - not yet populated by any data source

  isStarred       Boolean  @default(false)
  isQueued        Boolean  @default(false)
  isGenerated     Boolean  @default(false)

  scheduledPosts  ScheduledPost[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model KeywordSnapshot {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  seedKeyword     String   // The topic/query fed into the Trends API
  country         String   // ISO-2 code
  period          String   // "YYYY-MM"
  type            String   // "TOP" | "RISING"
  relatedQuery    String   // The discovered keyword phrase
  relativeValue   Int      // 0-100 popularity for TOP, growth % for RISING (5000 = Google's "Breakout" sentinel)
  rawGrowthLabel  String?  // e.g. "+250%" or "Breakout" as returned by the API

  fetchedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([projectId, seedKeyword, country, period, relatedQuery])
}
